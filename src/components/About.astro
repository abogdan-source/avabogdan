---
import { site } from '../content/site';
import SectionHead from './SectionHead.astro';
import Text from './Text.astro';
---

<section class="sec wrap" id="about">
  <SectionHead title="About">
    <p class="mono">01 · Bio</p>
  </SectionHead>
  <div class="about">
    <p class="lead">{site.bio.lead}</p>
    <div class="body">
      {site.bio.paragraphs.map((p) => (
        <p>
          <Text text={p} />
        </p>
      ))}
    </div>
    <ul class="facts mono">
      {site.facts.map((f) => (
        <li>
          <span>{f.label}</span>
          <span class:list={{ accent: f.accent }}>
            <Text text={f.value} />
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }
  .lead {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: var(--t-lead);
    line-height: 1.2;
    margin: 0;
  }
  .body p {
    margin: 0 0 1em;
    max-width: 62ch;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }
  .facts li span:first-child {
    color: var(--muted);
  }
  .accent {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
