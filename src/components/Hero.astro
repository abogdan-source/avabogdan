---
import { site } from '../content/site';
import PhotoFrame from './PhotoFrame.astro';
---

<div class="wrap hero">
  <div class="hero-top mono">
    <span>{site.roles.join(' · ')}</span>
    <span>{site.location}</span>
  </div>
  <h1 class="name">
    {site.name} <span class="it">studio</span>
  </h1>

  <div class="hero-grid">
    {site.hero.map((h) => (
      <figure>
        <PhotoFrame
          photo={h.photo}
          variant={h.variant}
          label={h.label}
          edge={h.edge}
          frame={h.frame}
          handwritten={h.handwritten}
          eager
          sizes="(max-width: 900px) 50vw, 33vw"
        />
        <figcaption class="cap mono" class:list={{ film: h.variant === 'film' }}>
          <span>{h.caption[0]}</span>
          <span>{h.caption[1]}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="thesis">
    <span class="mono muted">{site.indexLabel}</span>
    <p>{site.thesis}</p>
  </div>
</div>

<style>
  .hero {
    padding-block: clamp(28px, 5vw, 64px) 0;
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--muted);
  }
  .name {
    font-weight: 900;
    font-stretch: 62%;
    text-transform: uppercase;
    line-height: 0.82;
    font-size: var(--t-name);
    letter-spacing: -0.01em;
    margin: 18px 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.08em;
    flex-wrap: wrap;
  }
  .name .it {
    font-size: 0.62em;
    color: var(--accent);
    line-height: 1;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.4fr;
    gap: clamp(10px, 1.6vw, 20px);
    margin-top: clamp(20px, 3vw, 36px);
    align-items: end;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .cap {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--muted);
  }
  .cap.film {
    margin-top: 14px;
  }
  .thesis {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 24px;
    margin-top: clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--ink);
    padding-top: 16px;
  }
  .thesis p {
    font-size: var(--t-thesis);
    line-height: 1.15;
    margin: 0;
    font-weight: 500;
    font-stretch: 85%;
    text-wrap: balance;
    max-width: 28ch;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero-grid > :last-child {
      grid-column: 1 / -1;
    }
    .thesis {
      grid-template-columns: 1fr;
    }
  }
</style>
