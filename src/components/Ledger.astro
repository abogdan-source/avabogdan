---
import { events } from '../content/events';
import SectionHead from './SectionHead.astro';
import Text from './Text.astro';
---

<section class="sec wrap" id="events">
  <SectionHead title="PR, events" accent="& production">
    <p>
      Fashion PR at Lucien Pagès, plus the shows, launches and shoots I've produced, from call sheet
      to load-out.
    </p>
  </SectionHead>
  <div class="ledger-wrap">
    <table class="ledger">
      <thead class="mono">
        <tr>
          <th scope="col">Year</th>
          <th scope="col">Event</th>
          <th scope="col">Role</th>
          <th scope="col" class="hide-sm">
            Scope
          </th>
        </tr>
      </thead>
      <tbody>
        {events.map((r) => (
          <tr>
            <td class="yr">{r.year}</td>
            <td class="ev">
              <Text text={r.event} />
            </td>
            <td>
              <span class="tag">{r.role}</span>
            </td>
            <td class="hide-sm">
              <Text text={r.scope} />
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .ledger-wrap {
    overflow-x: auto;
  }
  .ledger {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th {
    text-align: left;
    font-weight: 400;
    color: var(--muted);
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--ink);
  }
  td {
    padding: 16px 12px 16px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .ev {
    font-weight: 700;
    font-stretch: 80%;
    font-size: 1.2rem;
    text-transform: uppercase;
    line-height: 1.15;
  }
  tr:hover .ev {
    color: var(--accent);
  }
  .yr {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .tag {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 10px;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }
  }
</style>
