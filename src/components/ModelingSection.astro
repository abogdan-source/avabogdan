---
import { modeling } from '../content/modeling';
import { site } from '../content/site';
import PhotoFrame from './PhotoFrame.astro';
import SectionHead from './SectionHead.astro';
import Text from './Text.astro';
---

<section class="sec wrap" id="modeling">
  <SectionHead title="Model" accent="ing" join>
    <p>A short selection. The full book, digitals and measurements live on my modeling site.</p>
  </SectionHead>
  <div class="model">
    <div class="selects">
      {modeling.selects.map((p) => (
        <PhotoFrame photo={p} label={p.label} sizes="(max-width: 560px) 50vw, 17vw" />
      ))}
    </div>
    <aside class="comp" aria-label="Comp card">
      <span class="mono muted">Comp card</span>
      <h3>{site.name}</h3>
      <dl class="mono">
        {modeling.stats.map((s) => (
          <>
            <dt>{s.label}</dt>
            <dd>
              <Text text={s.value} />
            </dd>
          </>
        ))}
      </dl>
      <a class="btn" href={modeling.bookUrl} target="_blank" rel="noopener">
        Full modeling book ↗
      </a>
    </aside>
  </div>
</section>

<style>
  .model {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(16px, 3vw, 40px);
    align-items: start;
  }
  .selects {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .comp {
    border: 1px solid var(--ink);
    padding: 18px;
  }
  h3 {
    margin: 0 0 12px;
    font-weight: 800;
    font-stretch: 62%;
    text-transform: uppercase;
    font-size: 1.8rem;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0 0 18px;
    font-variant-numeric: tabular-nums;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    text-align: right;
  }
  @media (max-width: 900px) {
    .model {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .selects {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
