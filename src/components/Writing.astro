---
import { writing } from '../content/writing';
import SectionHead from './SectionHead.astro';
import Text from './Text.astro';
---

<section class="sec wrap" id="writing">
  <SectionHead title="Writ" accent="ing" join>
    <p>Poems and short pieces. A few excerpts.</p>
  </SectionHead>
  <div class="poems">
    {writing.map((w) => (
      <article class="poem">
        <span class="mono muted">
          {w.kind} · {w.year}
        </span>
        <h3>
          <Text text={w.title} />
        </h3>
        <p>{w.excerpt}</p>
        {w.url && (
          <a class="mono more" href={w.url}>
            Read in full →
          </a>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .poems {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 40px);
  }
  .poem {
    min-width: 0;
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }
  h3 {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.8rem;
    margin: 6px 0 12px;
    line-height: 1.1;
  }
  p {
    font-family: var(--f-serif);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
    white-space: pre-line;
  }
  .more {
    display: inline-block;
    margin-top: 12px;
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .poems {
      grid-template-columns: 1fr;
    }
  }
</style>
