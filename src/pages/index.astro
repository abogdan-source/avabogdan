---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Design from '../components/Design.astro';
import Fashion from '../components/Fashion.astro';
import Hero from '../components/Hero.astro';
import Ledger from '../components/Ledger.astro';
import Marquee from '../components/Marquee.astro';
import ModelingSection from '../components/ModelingSection.astro';
import Nav from '../components/Nav.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Writing from '../components/Writing.astro';
---

<Base>
  <Nav />
  <main id="top">
    <Hero />
    <Marquee />
    <About />
    <Fashion />
    <PhotoGrid />
    <Design />
    <ModelingSection />
    <Ledger />
    <Writing />
  </main>
  <Contact />
</Base>
